{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sensor readings",
  "description": "Time-stamped measurements from field sensors (temperature, pressure, flow, humidity).",
  "type": "object",
  "additionalProperties": false,
  "required": ["timestamp", "sensor_id", "measurement", "value", "unit"],
  "x-unique-key": ["timestamp", "sensor_id", "measurement"],
  "properties": {
    "timestamp":   { "type": "string", "format": "date-time", "x-aliases": ["time", "datetime", "date time", "tidspunkt"] },
    "sensor_id":   { "type": "string", "minLength": 1, "x-aliases": ["sensor", "sensor id", "device", "device id", "tag"] },
    "measurement": { "type": "string", "enum": ["temperature", "pressure", "flow", "humidity"], "x-aliases": ["type", "quantity", "signal", "måling"] },
    "value":       { "type": "number", "x-aliases": ["reading", "val", "værdi"] },
    "unit":        { "type": "string", "enum": ["°C", "bar", "m3/h", "l/h", "%RH"], "x-aliases": ["units", "enhed"] },
    "site":        { "type": "string", "x-aliases": ["location", "plant", "lokation"] }
  }
}
