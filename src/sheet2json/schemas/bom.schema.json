{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bill of materials",
  "description": "One line per component on a PCB bill of materials (BOM).",
  "type": "object",
  "additionalProperties": false,
  "required": ["designators", "part_number", "quantity"],
  "x-unique-key": ["designators"],
  "properties": {
    "designators":   { "type": "string", "minLength": 1, "x-aliases": ["designator", "reference", "ref", "refdes", "ref des"] },
    "part_number":   { "type": "string", "minLength": 1, "x-aliases": ["mpn", "part no", "part no.", "part #", "manufacturer part number", "pn"] },
    "manufacturer":  { "type": "string", "x-aliases": ["mfr", "mfg", "maker", "producer"] },
    "description":   { "type": "string", "x-aliases": ["desc", "comment", "beskrivelse"] },
    "value":         { "type": "string", "x-aliases": ["val", "rating"] },
    "package":       { "type": "string", "x-aliases": ["footprint", "case", "pkg"] },
    "quantity":      { "type": "integer", "minimum": 1, "x-aliases": ["qty", "count", "antal", "amount"] },
    "unit_price_dkk":{ "type": "number", "minimum": 0, "x-aliases": ["unit price", "price", "price dkk", "unit price (dkk)", "pris"] },
    "supplier":      { "type": "string", "x-aliases": ["vendor", "distributor", "leverandør"] }
  }
}
